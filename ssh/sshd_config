# SSH Server Hardening
# Copy to /etc/ssh/sshd_config.d/99-hardening.conf
# Test with: sudo sshd -t && sudo systemctl reload sshd

# --- Authentication ---
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM yes

# --- Key exchange and ciphers (modern only) ---
KexAlgorithms curve25519-sha256,ecdh-sha2-nistp521,ecdh-sha2-nistp384
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# --- Session security ---
X11Forwarding no
PermitTTY yes
AllowTcpForwarding no
PermitTunnel no
PermitUserEnvironment no
AllowAgentForwarding no

# --- Timeouts ---
ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 30

# --- Misc ---
PrintMotd no
PrintLastLog yes
Banner none
StrictModes yes
MaxAuthTries 3
MaxSessions 5

# --- Restrict users (EDIT THIS) ---
# Uncomment and add your users, e.g.:
# AllowUsers alice bob
#
# If you skip this, any valid user on the system can SSH in.
# This is critical because PasswordAuthentication is disabled above.
