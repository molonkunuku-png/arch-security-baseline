# auditd monitoring rules
# Copy to /etc/audit/rules.d/99-hardening.rules
# Load with: sudo augenrules --load

# --- System calls ---
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

# --- SSH ---
-w /var/log/sshd/ -p rwxa -k sshd
-w /etc/ssh/sshd_config -p wa -k sshd_config

# --- Login/logout ---
-w /var/log/auth.log -p rwxa -k auth_log
-w /var/log/faillog -p rwxa -k faillog
-w /var/log/lastlog -p rwxa -k lastlog

# --- Process execution ---
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k privileged_exec
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k privileged_exec
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k privileged_exec
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k privileged_exec

# --- Kernel module loading ---
-w /sbin/insmod -p x -k modules
-w /sbin/rmmod -p x -k modules
-w /sbin/modprobe -p x -k modules
-a always,exit -F arch=b64 -S init_module,finit_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module -k modules

# --- Time changes ---
-a always,exit -S adjtimex,settimeofday -k time_change
-a always,exit -F arch=b64 -S clock_settime -k time_change

# --- Network changes ---
-w /etc/hosts -p wa -k network_config
-w /etc/hostname -p wa -k network_config
-w /etc/resolv.conf -p wa -k network_config

# --- Audit logs themselves ---
-w /etc/audit/ -p wa -k audit_config
-w /var/log/audit/ -p rwxa -k audit_log

# --- Privilege escalation tools ---
-w /usr/bin/sudo -p x -k sudo_exec
-w /usr/bin/su -p x -k su_exec
-w /usr/bin/pkexec -p x -k pkexec_exec
